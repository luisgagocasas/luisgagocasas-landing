    "/^python3 - << 'EOF'\nimport struct, zlib\n\ndef read_png_pixels\\(path, points\\):\n    with open\\(path, 'rb'\\) as f:\n        data = f\\.read\\(\\)\n    \n    # Parse IHDR\n    w = struct\\.unpack\\('>I', data\\[16:20\\]\\)\\[0\\]\n    h = struct\\.unpack\\('>I', data\\[20:24\\]\\)\\[0\\]\n    bit_depth = data\\[24\\]\n    color_type = data\\[25\\]\n    print\\(f\"PNG \\{w\\}x\\{h\\} bit_depth=\\{bit_depth\\} color_type=\\{color_type\\}\"\\)\n    \n    # Collect IDAT chunks\n    raw_idat = b''\n    pos = 8\n    while pos < len\\(data\\):\n        length = struct\\.unpack\\('>I', data\\[pos:pos\\+4\\]\\)\\[0\\]\n        chunk_type = data\\[pos\\+4:pos\\+8\\]\\.decode\\('ascii', errors='replace'\\)\n        if chunk_type == 'IDAT':\n            raw_idat \\+= data\\[pos\\+8:pos\\+8\\+length\\]\n        elif chunk_type == 'IEND':\n            break\n        pos \\+= 12 \\+ length\n    \n    raw = zlib\\.decompress\\(raw_idat\\)\n    \n    # Each row: 1 filter byte \\+ w\\*channels bytes\n    channels = \\{2:3, 6:4, 0:1, 3:1, 4:2\\}\\.get\\(color_type, 3\\)\n    stride = 1 \\+ w \\* channels\n    \n    results = \\{\\}\n    for \\(px, py\\) in points:\n        if px >= w or py >= h: continue\n        row_start = py \\* stride \\+ 1  # skip filter byte\n        idx = row_start \\+ px \\* channels\n        r, g, b = raw\\[idx\\], raw\\[idx\\+1\\], raw\\[idx\\+2\\]\n        results\\[\\(px, py\\)\\] = \\(r, g, b, f'#\\{r:02x\\}\\{g:02x\\}\\{b:02x\\}'\\)\n    \n    return results\n\npts = \\[\\(5,5\\),\\(425,5\\),\\(5,300\\),\\(425,300\\),\\(5,600\\),\\(425,600\\),\\(215,5\\),\\(5,900\\),\\(425,900\\)\\]\nr = read_png_pixels\\('/Users/luisgagoasas/project/ayphu-projects/luisgagocasas-landing/public/luisgagocasas\\.png', pts\\)\nfor k,v in r\\.items\\(\\):\n    print\\(f\"  \\(\\{k\\[0\\]:3\\},\\{k\\[1\\]:4\\}\\): \\{v\\[3\\]\\}\"\\)\nEOF$/": {
